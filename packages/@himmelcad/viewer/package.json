{
  "name": "@himmelcad/viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kernel": {
      "types": "./src/kernel/index.ts",
      "default": "./src/kernel/index.ts"
    },
    "./kernel/react": {
      "types": "./src/kernel/KernelViewport.tsx",
      "default": "./src/kernel/KernelViewport.tsx"
    },
    "./legacy": {
      "types": "./src/legacy.ts",
      "default": "./src/legacy.ts"
    }
  },
  "scripts": {
    "bindings:generate": "cargo run -p himmelcad-core --features ts-bindings --bin generate_entity_bindings",
    "bindings:check": "cargo run -p himmelcad-core --features ts-bindings --bin generate_entity_bindings -- --check",
    "typecheck": "tsc --noEmit",
    "typecheck:browser-kernel-contract": "tsc -p tsconfig.browser.json",
    "test": "tsc -p tsconfig.test.json && node --test dist/viewer-tests/test/*.test.js",
    "test:browser-kernel": "node test/browser/kernel-browser-e2e.mjs",
    "test:browser-kernel-webgpu": "node test/browser/kernel-browser-e2e.mjs --webgpu",
    "test:browser-kernel-webgl2": "node test/browser/kernel-browser-e2e.mjs --webgl2",
    "test:browser-kernel-real": "node test/browser/kernel-browser-e2e.mjs --real",
    "test:browser-kernel-real-webgl2": "node test/browser/kernel-browser-e2e.mjs --real --webgl2",
    "test:browser-kernel-color-parity": "node test/browser/kernel-color-parity.mjs",
    "test:browser-kernel-real-parity": "node test/browser/kernel-browser-e2e.mjs --real && node test/browser/kernel-browser-e2e.mjs --real --webgl2 && node test/browser/kernel-color-parity.mjs",
    "test:public-consumer-processes": "node test/consumer/public-process-hosts.mjs",
    "test:decode-wasm-artifact": "node ../../../scripts/check-decode-wasm-artifact.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@himmelcad/data": "workspace:*",
    "@himmelcad/three-loader": "workspace:*",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/react": "^19.0.0",
    "@types/three": "^0.169.0",
    "react": "^19.0.0"
  }
}
