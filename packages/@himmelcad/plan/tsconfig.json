{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild/types",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"]
}
