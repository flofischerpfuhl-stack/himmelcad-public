{
  "name": "@himmelcad/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./canonical": {
      "types": "./src/generated/index.ts",
      "default": "./src/generated/index.ts"
    }
  },
  "scripts": {
    "bindings:generate": "node ../../../scripts/run-cargo.mjs run -p himmelcad-core --features ts-bindings --bin generate_entity_bindings",
    "bindings:check": "node ../../../scripts/run-cargo.mjs run -p himmelcad-core --features ts-bindings --bin generate_entity_bindings -- --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.2"
  }
}
