{
  "name": "@himmelcad/automation-host",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./electron": {
      "types": "./electron.d.ts",
      "require": "./electron.cjs",
      "default": "./electron.cjs"
    },
    "./provider-credentials": {
      "types": "./provider-credentials.d.ts",
      "require": "./provider-credentials.cjs",
      "default": "./provider-credentials.cjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@himmelcad/agent": "workspace:*",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.2"
  }
}
