{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".tsbuild/types",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": [
    "index.cjs",
    "index.d.ts",
    "electron.cjs",
    "electron.d.ts",
    "provider-credentials.cjs",
    "provider-credentials.d.ts"
  ],
  "references": [{ "path": "../agent" }]
}
