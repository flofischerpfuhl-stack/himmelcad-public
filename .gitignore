# Rust-generated canonical typings are committed and drift-checked so every
# package and external SDK build sees the exact same contract revision.

# Local project data while developing
.scratch/
*.hcad/
*.hcadx
!docs/**/*.hcad/
!docs/**/*.hcadx

# Logs
logs/
*.log

# Reference / inspiration material — NOT shipped in the product, NOT committed.
# Each developer fetches their own copy. See libs/README.md for the expected
# layout and licensing rules in AGENTS.md §1.5.
libs/
!libs/README.md

# Vendored sources (in vendor/) ARE committed per AGENTS.md §1.6 — they are
# part of HimmelCAD. The exception is binary artifacts that are downloaded
# on `pnpm install` via `scripts/fetch-vendor.mjs` (SHA-256 verified). Those
# are gitignored to keep the repo small.
vendor/potreeconverter/*/PotreeConverter
vendor/potreeconverter/*/PotreeConverter.exe
vendor/potreeconverter/*/*laszip*.so
vendor/potreeconverter/*/*laszip*.dll
vendor/potreeconverter/*/*.zip
vendor/brush/*/brush_app
vendor/brush/*/brush_app.exe
vendor/brush/*/*.zip
vendor/brush/*/*.tar.xz
vendor/photolab-models/**/*.onnx
vendor/photolab-models/**/*.pth
vendor/photolab-models/**/*.pt
vendor/dedode/**/*.pth
vendor/dedode/**/*.pt
vendor/dedode/onnx/
vendor/dedode/dev/

# User-supplied photogrammetry/reference archives and extracted working copies.
photolab/01_Transformation/
vendor/colmap/*/bin/
vendor/colmap/*/include/
vendor/colmap/*/lib/
vendor/colmap/*/share/
vendor/msvc-runtime/*/*.dll
vendor/three-loader/node_modules/

# Local PhotoLab reference datasets and user-supplied test archives. Curated
# manifests, concepts and golden baselines remain committed explicitly.
photolab/Agisoft Exampleprojects/
photolab/*.pdf
photolab/*.zip
photolab/*.crdownload*
photolab/.xdp-*
.build/

# himmel:cap secrets (NTRIP, OAuth) — never commit
.env.local
.env.*.local
**/hcap-secrets*
**/google-services.json.local
apps/cap/android/key.properties
apps/cap/**/Secrets.local.*
