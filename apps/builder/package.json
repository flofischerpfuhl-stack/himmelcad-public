{
  "name": "@himmelcad/builder",
  "version": "0.1.0",
  "private": true,
  "description": "HimmelCAD Builder — desktop CAD for 3D point clouds",
  "author": {
    "name": "HimmelCAD",
    "email": "noreply@himmelcad.local"
  },
  "homepage": "https://gitlab.com/florian-fischer-group/himmelcad",
  "desktopName": "himmelcad-builder.desktop",
  "license": "BUSL-1.1",
  "main": "dist/electron/main.js",
  "scripts": {
    "prepare:viewer": "node ../../scripts/stage-builder-viewer-wasm.mjs",
    "dev": "pnpm prepare:viewer && concurrently -k -n vite,electron -c blue,green \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://localhost:5173 && node ../../scripts/run-electron.mjs .",
    "build:sidecar": "node ../../scripts/run-cargo.mjs build --release --bin himmelcad-sidecar --manifest-path ../../Cargo.toml",
    "build:sidecar:win": "node ../../scripts/build-photolab-windows-rust.mjs",
    "build": "pnpm build:sidecar && pnpm prepare:viewer && vite build && tsc -p tsconfig.electron.json",
    "build:win": "pnpm build:sidecar:win && pnpm prepare:viewer && vite build && tsc -p tsconfig.electron.json",
    "package:linux": "pnpm build && electron-builder --config electron-builder.linux.yml --linux x64",
    "package:win": "pnpm build:win && electron-builder --config electron-builder.win.yml --win x64",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@himmelcad/console": "workspace:*",
    "@himmelcad/data": "workspace:*",
    "@himmelcad/plan": "workspace:*",
    "@himmelcad/specs": "workspace:*",
    "@himmelcad/theme": "workspace:*",
    "@himmelcad/ui": "workspace:*",
    "@himmelcad/viewer": "workspace:*",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "43.1.0",
    "electron-builder": "26.15.6",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.12"
  }
}
