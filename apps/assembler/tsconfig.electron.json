{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist/electron",
    "rootDir": "electron",
    "noEmit": false,
    "jsx": "preserve",
    "lib": ["ES2023"],
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "isolatedModules": false,
    "incremental": true,
    "tsBuildInfoFile": "dist/electron/.tsbuildinfo"
  },
  "include": ["electron"]
}
