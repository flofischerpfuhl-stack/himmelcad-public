{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himmelcad.local/schemas/assembler/agent-api-v1.schema.json",
  "title": "HimmelCAD Assembler agent API",
  "api": "hcasm.agent-api",
  "version": 1,
  "units": {
    "length": "mm",
    "angle": "deg",
    "up": "+Z"
  },
  "transport": {
    "framing": "JSON-RPC 2.0; headless: one JSON object per line on stdio; app: HTTP POST /rpc",
    "auth": "app endpoint: \"Authorization: Bearer <session token>\", loopback only, off by default"
  },
  "errorCodes": [
    "invalidRequest",
    "methodNotFound",
    "invalidParams",
    "notFound",
    "referenceNotFound",
    "featureFailed",
    "conflict",
    "busy",
    "transactionState",
    "permissionDenied",
    "confirmationRequired",
    "unsupported",
    "cancelled",
    "internal"
  ],
  "capabilities": [
    "document.read",
    "document.write",
    "view.write",
    "filesystem.read",
    "filesystem.write"
  ],
  "$defs": {
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "FaceSignature": {
      "type": "object",
      "properties": {
        "surface": {
          "enum": ["plane", "cylinder", "cone", "sphere", "torus", "other"]
        },
        "normal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vec3"
            },
            {
              "type": "null"
            }
          ]
        },
        "centroid": {
          "$ref": "#/$defs/Vec3"
        },
        "area": {
          "type": "number"
        },
        "adjacentFaces": {
          "type": "number"
        }
      },
      "required": ["surface", "normal", "centroid", "area", "adjacentFaces"],
      "additionalProperties": false
    },
    "EdgeSignature": {
      "type": "object",
      "properties": {
        "curve": {
          "enum": ["line", "circle", "ellipse", "other"]
        },
        "midpoint": {
          "$ref": "#/$defs/Vec3"
        },
        "length": {
          "type": "number"
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vec3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["curve", "midpoint", "length", "direction"],
      "additionalProperties": false
    },
    "FaceRef": {
      "type": "object",
      "properties": {
        "bodyId": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "$ref": "#/$defs/FaceSignature"
        }
      },
      "required": ["bodyId", "key"],
      "additionalProperties": false,
      "description": "Stable face reference. `signature` is optional on input; the server fills it from the current evaluation."
    },
    "EdgeRef": {
      "type": "object",
      "properties": {
        "bodyId": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "$ref": "#/$defs/EdgeSignature"
        }
      },
      "required": ["bodyId", "key"],
      "additionalProperties": false,
      "description": "Stable edge reference (`key` is \"<faceKeyA>|<faceKeyB>\"). `signature` is optional on input."
    },
    "Selector": {
      "type": "object",
      "properties": {
        "bodyId": {
          "type": "string",
          "minLength": 1
        },
        "select": {
          "type": "string",
          "minLength": 1,
          "description": "CadQuery-style selector: \"+Z\"/\"-X\" (planar faces facing / lines along), \"|Z\" (parallel), \"#Z\" (perpendicular), \">Z\"/\"<Z\" (max/min along axis), \"%PLANE\", \"%CYLINDER\", \"%LINE\", \"%CIRCLE\"; combine with \" and \"."
        }
      },
      "required": ["bodyId", "select"],
      "additionalProperties": false
    },
    "FaceInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/FaceRef"
        },
        {
          "$ref": "#/$defs/Selector"
        }
      ]
    },
    "EdgeInput": {
      "oneOf": [
        {
          "$ref": "#/$defs/EdgeRef"
        },
        {
          "$ref": "#/$defs/Selector"
        }
      ]
    },
    "SketchProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rectangle"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": ["kind", "x", "y", "width", "height"],
          "additionalProperties": false,
          "description": "Axis-aligned rectangle in sketch (u, v) coordinates; (x, y) is a corner."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "circle"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["kind", "cx", "cy", "radius"],
          "additionalProperties": false
        }
      ]
    },
    "SketchPlane": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "plane"
            },
            "plane": {
              "enum": ["XY", "XZ", "YZ"]
            },
            "offset": {
              "type": "number"
            }
          },
          "required": ["kind", "plane"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "face"
            },
            "face": {
              "$ref": "#/$defs/FaceInput"
            }
          },
          "required": ["kind", "face"],
          "additionalProperties": false
        }
      ]
    },
    "ExtrudeProfile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sketch"
            },
            "featureId": {
              "type": "string",
              "minLength": 1
            },
            "profileIndex": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["kind", "featureId"],
          "additionalProperties": false,
          "description": "All profiles of the sketch (fused) unless `profileIndex` is given."
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "face"
            },
            "face": {
              "$ref": "#/$defs/FaceInput"
            }
          },
          "required": ["kind", "face"],
          "additionalProperties": false,
          "description": "Push/pull of a planar body face along its outward normal."
        }
      ]
    },
    "SelectionItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "body"
            },
            "bodyId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "bodyId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "face"
            },
            "bodyId": {
              "type": "string",
              "minLength": 1
            },
            "faceKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "bodyId", "faceKey"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "edge"
            },
            "bodyId": {
              "type": "string",
              "minLength": 1
            },
            "edgeKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "bodyId", "edgeKey"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "sketchProfile"
            },
            "featureId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "featureId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "feature"
            },
            "featureId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "featureId"],
          "additionalProperties": false
        }
      ]
    }
  },
  "featureKinds": {
    "sketch": {
      "label": "Sketch",
      "summary": "Closed profiles on a construction plane or a planar body face (mm, sketch u/v).",
      "params": {
        "type": "object",
        "properties": {
          "plane": {
            "$ref": "#/$defs/SketchPlane"
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SketchProfile"
            },
            "minItems": 1
          }
        },
        "required": ["plane", "profiles"],
        "additionalProperties": false
      }
    },
    "extrude": {
      "label": "Extrude",
      "summary": "Extrudes sketch profiles (or pushes/pulls a planar face) along the sketch normal; negative distance goes the other way.",
      "params": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/$defs/ExtrudeProfile"
          },
          "distance": {
            "type": "number"
          },
          "symmetric": {
            "type": "boolean",
            "default": false
          },
          "operation": {
            "enum": ["new", "join", "cut"],
            "default": "new"
          },
          "targetBodyId": {
            "type": "string",
            "minLength": 1
          },
          "resultBodyName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["profile", "distance"],
        "additionalProperties": false
      }
    },
    "fillet": {
      "label": "Fillet",
      "summary": "Rounds edges of one body with a constant radius (exact B-rep fillet).",
      "params": {
        "type": "object",
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/EdgeInput"
            },
            "minItems": 1
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["edges", "radius"],
        "additionalProperties": false
      }
    },
    "chamfer": {
      "label": "Chamfer",
      "summary": "Bevels edges of one body with a constant distance.",
      "params": {
        "type": "object",
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/EdgeInput"
            },
            "minItems": 1
          },
          "distance": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["edges", "distance"],
        "additionalProperties": false
      }
    },
    "shell": {
      "label": "Shell",
      "summary": "Hollows a body, opening the given faces; walls grow inwards.",
      "params": {
        "type": "object",
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "faces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/FaceInput"
            },
            "minItems": 1
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": ["faces", "thickness"],
        "additionalProperties": false
      }
    },
    "boolean": {
      "label": "Boolean",
      "summary": "Union/subtract/intersect; the tool bodies are consumed.",
      "params": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": ["union", "subtract", "intersect"]
          },
          "targetBodyId": {
            "type": "string",
            "minLength": 1
          },
          "toolBodyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": ["operation", "targetBodyId", "toolBodyIds"],
        "additionalProperties": false
      }
    },
    "move": {
      "label": "Move",
      "summary": "Translates a body by (dx, dy, dz) mm.",
      "params": {
        "type": "object",
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "dx": {
            "type": "number"
          },
          "dy": {
            "type": "number"
          },
          "dz": {
            "type": "number"
          }
        },
        "required": ["bodyId"],
        "additionalProperties": false,
        "description": "Missing components default to 0."
      }
    },
    "setAppearance": {
      "label": "Appearance",
      "summary": "Sets a body display color (#RRGGBB); written to 3MF/STEP.",
      "params": {
        "type": "object",
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": ["bodyId", "color"],
        "additionalProperties": false
      }
    },
    "importStep": {
      "label": "Import",
      "summary": "A STEP file embedded (base64) as one history step producing bodies.",
      "params": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1
          },
          "fileName": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["data", "fileName"],
        "additionalProperties": false
      }
    }
  },
  "methods": {
    "api.hello": {
      "kind": "meta",
      "capability": "document.read",
      "summary": "Negotiates the protocol version and reports capabilities.",
      "params": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "{api, version, server: \"headless\"|\"app\", capabilities[], units: \"mm\", featureKinds[]}"
    },
    "api.describe": {
      "kind": "meta",
      "capability": "document.read",
      "summary": "Returns this contract (JSON Schema of every method and feature kind).",
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": "The hcasm.agent-api@1 schema document."
    },
    "document.get": {
      "kind": "query",
      "capability": "document.read",
      "summary": "Document info: name, revision, counts, undo/redo state, open transaction.",
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": "{projectName, revision, units, featureCount, bodyCount, canUndo, canRedo, transaction: null|{id,label,commands}, kernel}"
    },
    "features.list": {
      "kind": "query",
      "capability": "document.read",
      "summary": "The feature history in order, with parameters and per-feature errors.",
      "params": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "[{id, name, kind, suppressed, params, error?, warning?}]"
    },
    "feature.get": {
      "kind": "query",
      "capability": "document.read",
      "summary": "One feature with parameters.",
      "params": {
        "type": "object",
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": ["featureId"],
        "additionalProperties": false
      },
      "result": "{id, name, kind, suppressed, params, error?, warning?}"
    },
    "bodies.list": {
      "kind": "query",
      "capability": "document.read",
      "summary": "Evaluated bodies with exact bbox, volume, surface area and validity.",
      "params": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "[{id, name, color, createdBy, valid, volume, area, bbox: {min, max, size}, faceCount, edgeCount}]"
    },
    "body.get": {
      "kind": "query",
      "capability": "document.read",
      "summary": "One evaluated body.",
      "params": {
        "type": "object",
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": ["bodyId"],
        "additionalProperties": false
      },
      "result": "Same shape as a bodies.list entry."
    },
    "faces.list": {
      "kind": "query",
      "capability": "document.read",
      "summary": "Faces of a body with stable keys, readable names and geometric descriptors.",
      "params": {
        "type": "object",
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "select": {
            "type": "string"
          },
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": ["bodyId"],
        "additionalProperties": false
      },
      "result": "[{bodyId, key, aliases, name, surface, normal, centroid, area, adjacentFaces, edgeKeys}]"
    },
    "edges.list": {
      "kind": "query",
      "capability": "document.read",
      "summary": "Edges of a body with stable keys, readable names and geometric descriptors.",
      "params": {
        "type": "object",
        "properties": {
          "bodyId": {
            "type": "string",
            "minLength": 1
          },
          "select": {
            "type": "string"
          },
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": ["bodyId"],
        "additionalProperties": false
      },
      "result": "[{bodyId, key, name, curve, midpoint, length, direction, radius, faceKeys}]"
    },
    "sketches.list": {
      "kind": "query",
      "capability": "document.read",
      "summary": "Sketches with their frame and profiles (parameters and world-space centres).",
      "params": {
        "type": "object",
        "properties": {
          "scope": {
            "enum": ["auto", "committed", "staged"],
            "default": "auto",
            "description": "`auto`: the open transaction's staged state if any, else the committed document."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result": "[{featureId, name, plane, frame: {origin,u,v,normal}, profiles: [{index, kind, params, center}], consumed}]"
    },
    "selection.get": {
      "kind": "query",
      "capability": "document.read",
      "summary": "The UI selection (stable keys).",
      "params": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "result": "[SelectionItem]"
    },
    "selection.set": {
      "kind": "command",
      "capability": "view.write",
      "summary": "Replaces the UI selection (view state, not undoable).",
      "params": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SelectionItem"
            }
          }
        },
        "required": ["items"],
        "additionalProperties": false
      },
      "result": "{selection}"
    },
    "feature.create": {
      "kind": "command",
      "capability": "document.write",
      "transactional": true,
      "summary": "Appends a feature of `kind` with `params` (one undo step unless in a transaction).",
      "params": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "Optimistic concurrency: the command fails with `conflict` unless the document revision still equals this value."
          }
        },
        "required": ["kind", "params"],
        "additionalProperties": false
      },
      "result": "{featureId, name, kind, createdBodyIds, revision, committed, errors, warnings, bodies}"
    },
    "feature.edit": {
      "kind": "command",
      "capability": "document.write",
      "transactional": true,
      "summary": "Changes parameters of an existing feature (shallow merge); downstream re-evaluates.",
      "params": {
        "type": "object",
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "type": "object"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "Optimistic concurrency: the command fails with `conflict` unless the document revision still equals this value."
          }
        },
        "required": ["featureId", "params"],
        "additionalProperties": false
      },
      "result": "{featureId, revision, committed, errors, warnings, bodies}"
    },
    "feature.delete": {
      "kind": "command",
      "capability": "document.write",
      "transactional": true,
      "summary": "Removes a feature from the history.",
      "params": {
        "type": "object",
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "Optimistic concurrency: the command fails with `conflict` unless the document revision still equals this value."
          }
        },
        "required": ["featureId"],
        "additionalProperties": false
      },
      "result": "{featureId, revision, committed, errors}"
    },
    "feature.suppress": {
      "kind": "command",
      "capability": "document.write",
      "transactional": true,
      "summary": "Suppresses or unsuppresses a feature.",
      "params": {
        "type": "object",
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "suppressed": {
            "type": "boolean"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "Optimistic concurrency: the command fails with `conflict` unless the document revision still equals this value."
          }
        },
        "required": ["featureId", "suppressed"],
        "additionalProperties": false
      },
      "result": "{featureId, revision, committed, errors}"
    },
    "feature.rename": {
      "kind": "command",
      "capability": "document.write",
      "transactional": true,
      "summary": "Renames a history card.",
      "params": {
        "type": "object",
        "properties": {
          "featureId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "description": "Optimistic concurrency: the command fails with `conflict` unless the document revision still equals this value."
