{
  "name": "@himmelcad/assembler",
  "version": "0.0.0",
  "private": true,
  "description": "HimmelCAD Assembler - desktop CAD for 3D printing",
  "author": {
    "name": "HimmelCAD",
    "email": "noreply@himmelcad.local"
  },
  "homepage": "https://gitlab.com/florian-fischer-group/himmelcad",
  "desktopName": "HimmelCAD Assembler",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "assembler-headless": "bin/assembler-headless.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:web": "vite --host",
    "dev:electron": "tsc -p tsconfig.electron.json && node scripts/postbuild-electron.mjs && wait-on http://localhost:5175 && node ../../scripts/run-electron.mjs .",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/postbuild-electron.mjs",
    "build:headless": "tsc -p tsconfig.headless.json",
    "api:schema": "pnpm build:headless && node bin/assembler-headless.mjs --write-schema api/agent-api-v1.schema.json",
    "build": "vite build && pnpm build:electron && pnpm build:headless",
    "icon": "node scripts/generate-icon.mjs",
    "package:win": "pnpm build && pnpm icon && electron-builder --config electron-builder.win.yml --win --x64 --publish never",
    "typecheck": "tsc -b tsconfig.json tsconfig.typecheck-electron.json && tsc -p tsconfig.headless.json --noEmit",
    "test": "tsc -p tsconfig.test.json && pnpm build:headless && node --test .build/tests/apps/assembler/test/windowOptions.test.js .build/tests/apps/assembler/test/electron/recentFiles.test.js .build/tests/apps/assembler/test/model/store.test.js .build/tests/apps/assembler/test/model/commands.test.js .build/tests/apps/assembler/test/model/tools.test.js .build/tests/apps/assembler/test/model/modeling.test.js .build/tests/apps/assembler/test/model/featureIdReseed.test.js .build/tests/apps/assembler/test/model/project/format.test.js .build/tests/apps/assembler/test/model/project/projectStore.test.js .build/tests/apps/assembler/test/model/project/dirtyFromStartup.test.js .build/tests/apps/assembler/test/model/project/meshCodec.test.js .build/tests/apps/assembler/test/model/project/roundTrip.test.js .build/tests/apps/assembler/test/kernel/adapter.test.js .build/tests/apps/assembler/test/kernel/naming.test.js .build/tests/apps/assembler/test/kernel/evaluator.test.js .build/tests/apps/assembler/test/kernel/stlExport.test.js .build/tests/apps/assembler/test/kernel/stlImport.test.js .build/tests/apps/assembler/test/kernel/threeMf.test.js .build/tests/apps/assembler/test/kernel/stepRoundTrip.test.js .build/tests/apps/assembler/test/viewport/math.test.js .build/tests/apps/assembler/test/viewport/camera.test.js .build/tests/apps/assembler/test/viewport/expr.test.js .build/tests/apps/assembler/test/viewport/picking.test.js .build/tests/apps/assembler/test/viewport/toolAnchors.test.js .build/tests/apps/assembler/test/api/contract.test.js .build/tests/apps/assembler/test/api/session.test.js .build/tests/apps/assembler/test/api/automationServer.test.js .build/tests/apps/assembler/test/api/headless.test.js .build/tests/apps/assembler/test/api/printTools.test.js .build/tests/apps/assembler/test/model/featureTools.test.js .build/tests/apps/assembler/test/kernel/features.test.js .build/tests/apps/assembler/test/kernel/printTools.test.js .build/tests/apps/assembler/test/model/printFeatureTools.test.js .build/tests/apps/assembler/test/kernel/incremental.test.js .build/tests/apps/assembler/test/kernel/references.test.js .build/tests/apps/assembler/test/kernel/recovery.test.js .build/tests/apps/assembler/test/model/kernelActivity.test.js .build/tests/apps/assembler/test/viewport/toolHandles.test.js .build/tests/apps/assembler/test/sketch/solver.test.js .build/tests/apps/assembler/test/sketch/regions.test.js .build/tests/apps/assembler/test/sketch/tools.test.js .build/tests/apps/assembler/test/sketch/session.test.js .build/tests/apps/assembler/test/viewport/selection.test.js .build/tests/apps/assembler/test/model/workspace.test.js .build/tests/apps/assembler/test/model/rollback.test.js .build/tests/apps/assembler/test/sketch/sketchBoxSelect.test.js",
    "bench:kernel": "tsc -p tsconfig.test.json && node .build/tests/apps/assembler/test/bench/kernelBench.js",
    "test:electron": "pnpm build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-timeout=300000 .build/tests/apps/assembler/test/electron/production.test.js .build/tests/apps/assembler/test/electron/agentAccess.test.js .build/tests/apps/assembler/test/electron/kernelDeterminism.test.js"
  },
  "dependencies": {
    "@himmelcad/theme": "workspace:*",
    "@himmelcad/ui": "workspace:*",
    "@salusoft89/planegcs": "1.2.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "43.1.0",
    "electron-builder": "26.15.6",
    "playwright-core": "^1.57.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
