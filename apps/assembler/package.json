{
  "name": "@himmelcad/assembler",
  "version": "0.0.0",
  "private": true,
  "description": "HimmelCAD Assembler — desktop CAD for 3D printing (Phase 0 skeleton)",
  "author": {
    "name": "HimmelCAD",
    "email": "noreply@himmelcad.local"
  },
  "homepage": "https://gitlab.com/florian-fischer-group/himmelcad",
  "desktopName": "HimmelCAD Assembler",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:web": "vite --host",
    "dev:electron": "tsc -p tsconfig.electron.json && wait-on http://localhost:5175 && node ../../scripts/run-electron.mjs .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && pnpm build:electron",
    "typecheck": "tsc -b tsconfig.json tsconfig.typecheck-electron.json",
    "test": "tsc -p tsconfig.test.json && node --test .build/tests/apps/assembler/test/windowOptions.test.js"
  },
  "dependencies": {
    "@himmelcad/theme": "workspace:*",
    "@himmelcad/ui": "workspace:*",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "43.1.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
